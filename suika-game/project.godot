; Engine configuration file.
; Suika (Watermelon) Game clone — Godot 4.x
;
; To open this project: Godot editor -> Import -> select this project.godot

config_version=5

[application]

config/name="Suika Game Clone"
config/description="A physics-based fruit merging game (Suika Game clone) built with Godot 4."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

2d/default_gravity=1400.0
common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
